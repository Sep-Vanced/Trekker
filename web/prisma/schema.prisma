generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── Enums ────────────────────────────────────────────────────────────────────
enum Role {
  trekker
  ranger
}

enum RegistrationStatus {
  registered
  completed
  cancelled
  overdue
}

enum CheckpointType {
  waypoint
  danger
  rest
  camp
  emergency
}

enum RouteStatus {
  open
  caution
  closed
}

enum SosStatus {
  active
  resolved
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                      Int       @id @default(autoincrement())
  username                String    @unique
  password                String
  email                   String    @unique
  first_name              String
  last_name               String
  role                    Role      @default(trekker)
  phone                   String?
  emergency_contact_name  String?
  emergency_contact_phone String?
  offline_maps_downloaded Boolean   @default(false)
  last_known_latitude     Float?
  last_known_longitude    Float?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  registrations TourismRegistration[]
  sessions      TrekkingSession[]
  sosAlerts     SosAlert[]
}

model Campsite {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  latitude    String
  longitude   String
  phase       String
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  routes TrekRoute[]
}

model TrekRoute {
  id                Int         @id @default(autoincrement())
  name              String
  description       String?
  difficulty        String
  difficulty_score  Int         @default(1)
  status            RouteStatus @default(open)
  start_name        String
  start_latitude    String
  start_longitude   String
  end_latitude      String
  end_longitude     String
  total_distance_km String
  estimated_hours   String
  allowed_vehicles  String?
  elevation_gain_m  Int         @default(0)
  offline_map_file  String?
  is_active         Boolean     @default(true)
  destination       Int
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  campsite       Campsite            @relation(fields: [destination], references: [id])
  checkpoints    Checkpoint[]
  registrations  TourismRegistration[]
  sessions       TrekkingSession[]
  weatherReports WeatherReport[]
}

model Checkpoint {
  id            Int            @id @default(autoincrement())
  name          String
  order         Int
  latitude      String
  longitude     String
  cp_type       CheckpointType @default(waypoint)
  description   String?
  alert_message String?
  radius_meters Int            @default(50)
  is_mandatory  Boolean        @default(false)
  route         Int

  trekRoute TrekRoute @relation(fields: [route], references: [id])
}

model TourismRegistration {
  id            Int                @id @default(autoincrement())
  permit_number String             @unique
  qr_code       String?
  profile_id    Int
  route_id      Int
  status        RegistrationStatus @default(registered)
  group_size    Int                @default(1)
  age           Int?
  citizen       String?
  place         String?
  pax           Int                @default(1)
  planned_entry DateTime
  planned_exit  DateTime
  actual_entry  DateTime?
  actual_exit   DateTime?
  is_overdue    Boolean            @default(false)
  trek_duration String?
  notes         String?
  registered_at DateTime           @default(now())
  updated_at    DateTime           @updatedAt

  user  User      @relation(fields: [profile_id], references: [id])
  route TrekRoute @relation(fields: [route_id], references: [id])
}

model TrekkingSession {
  id         Int      @id @default(autoincrement())
  started_at DateTime @default(now())
  ended_at   DateTime?
  is_active  Boolean  @default(true)
  profile    Int
  route      Int

  user         User           @relation(fields: [profile], references: [id])
  trekRoute    TrekRoute      @relation(fields: [route], references: [id])
  locationLogs LocationLog[]
}

model LocationLog {
  id          Int      @id @default(autoincrement())
  latitude    String
  longitude   String
  recorded_at DateTime @default(now())
  session     Int

  trekkingSession TrekkingSession @relation(fields: [session], references: [id])
}

model WeatherReport {
  id                Int      @id @default(autoincrement())
  route             Int
  condition         String
  condition_display String
  temperature_c     String
  wind_speed_kph    String
  rainfall_mm       String
  humidity_pct      Int
  is_safe_to_trek   Boolean  @default(true)
  recorded_at       DateTime @default(now())

  trekRoute TrekRoute @relation(fields: [route], references: [id])
}

model SosAlert {
  id          Int       @id @default(autoincrement())
  profile_id  Int
  latitude    Float?
  longitude   Float?
  message     String?
  status      SosStatus @default(active)
  created_at  DateTime  @default(now())
  resolved_at DateTime?

  user User @relation(fields: [profile_id], references: [id])
}